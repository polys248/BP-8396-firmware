# ── Secrets / sensitive (NEVER commit) ───────────────────────────────────────
# Device TLS private keys and client certs (keep Mozilla cacert.pem, see below).
**/server.key
**/server.pem
**/ClientCert.*
*.key
# Root-password cracking artifacts + wordlists (RE context, not ours)
crack_result.txt
wordlists/
# Captured device HTTP traffic (may contain auth material)
httpv2.txt
# Fleet/prod tokens are never stored in-tree, but guard anyway
prod_fleet_token
*fleet_token*
*.token
# Exported person records from replay_kit (contain biometric templates — never commit)
replay_kit/*.json
replay_kit/*.out

# ── Vendor IP / extracted firmware (large, redistributable? no) ───────────────
vendor/
webroot-dump/

# ── Build outputs (regenerated by the build scripts) ─────────────────────────
# Compiled ARM service binaries
/bpagent/bpagent
/ttproxy/ttproxy
/hardened/webflash/webflash
# Firmware images, recovery zips, UI packages, bundles
*.img
*.zip
*.tgz
chisel/chisel.gz
ts-bundle/ts-data-bundle.tgz
ts-bundle/tailscale/
# staging / scratch
*.part
.webflash.*

# ── OS / tooling cruft ───────────────────────────────────────────────────────
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.swp
*~

# Keep the Mozilla CA bundle that ttproxy/webflash/bpagent embed at build time
!**/cacert.pem
