# Normalize line endings; shell scripts + init scripts MUST stay LF for the device.
* text=auto
*.sh        text eol=lf
*.py        text eol=lf
*.go        text eol=lf
S61hardening text eol=lf
S60face-recg text eol=lf
S40tailscale text eol=lf
*.md        text eol=lf

# Treat embedded binaries/assets as binary
*.pem       -text
*.png       binary
*.jpg       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
